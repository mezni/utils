# ==========================================
# Rust / Cargo
# ==========================================
# Generated by Cargo when compiling
/target/

# Remove this macro if you want to track your Cargo.lock file.
# For binaries/apps, it's recommended to keep Cargo.lock. For libraries, ignore it.
# Cargo.lock

# These are generated by Cargo when running benchmarks or tests
**/*.rs.bk
/examples/*.fingerprint
/examples/*.d

# ==========================================
# React / Node.js (Vite, Next.js, CRA)
# ==========================================
# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds
/dist/
/build/
/out/
/.next/

# Testing
/coverage/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDEs, Editors, & OS Specific
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (IntelliJ, WebStorm, CLion)
.idea/
*.iml

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
