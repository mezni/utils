# BorneMap Mobile Driver - Environment Configuration
#
# Set the API base URL to your local Traefik instance.
# Find your LAN IP with: ip addr show | grep 'inet 192'
# Example: API_BASE_URL=http://192.168.1.42:80
#
# Default (emulator): http://localhost:3001
#
# NOTE: The env var is read at build time by Expo.
# For runtime config, set in app.json under expo.extra.apiBaseUrl.
API_BASE_URL=http://localhost:3001
