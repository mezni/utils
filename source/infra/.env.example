# BorneMap — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# Postgres (static dev passwords — change for production)
POSTGRES_PASSWORD=postgres_dev_pass
KEYCLOAK_DB_PASSWORD=keycloak_dev_pass

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pass
