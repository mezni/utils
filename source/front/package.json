{
  "name": "bornemap-front",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r exec eslint src/ --ext .ts,.tsx",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx}'",
    "build": "pnpm -r build",
    "build:tokens": "pnpm --filter @bornemap/tokens build",
    "build:ui": "pnpm --filter @bornemap/ui build"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.5.2",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "react-native-web": "^0.21.2",
    "ts-jest": "^29.4.11"
  }
}
