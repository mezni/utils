{
  "name": "@bornemap/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --external react --external react-native",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch --external react --external react-native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "jest --passWithNoTests",
    "analyze-bundle": "tsx scripts/analyze-bundle.ts",
    "validate-contrast": "tsx scripts/validate-contrast.ts"
  },
  "dependencies": {
    "@bornemap/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": "^0.76.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/react": "^19.0.0",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.5.0"
  }
}
