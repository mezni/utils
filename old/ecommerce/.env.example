# Fake E-Commerce Server - example configuration
#
# Copy to `.env` and edit, or ignore it entirely: every setting below has a default, so
# the server starts with no configuration file present (see docs/configuration.md).
# Never commit a real `.env`. No secret is required to run the server.
#
# Only the settings in the "Honored" block below are read by the current code. Settings
# marked "not yet honored" are published for later phases; setting them changes nothing
# today, and listing them here is not a claim that they work.

# ---------------------------------------------------------------------------
# Honored
# ---------------------------------------------------------------------------

# Application identity. APP_VERSION is the version published in the API description.
# It must equal the installed package version; `make check` fails if they drift.
APP_NAME="Fake E-Commerce Server"
APP_VERSION="0.1.0"

# development | production | test
APP_ENV=development

# Prefix for all versioned public routes. The liveness check stays outside it.
# Must not be empty.
API_V1_PREFIX=/api/v1

# Serve /docs and /openapi.json. Convenience switch, NOT a security control.
API_DOCS_ENABLED=true

# Serve /redoc. Convenience switch, NOT a security control.
API_REDOC_ENABLED=true

# Default bind is loopback so a development start is not reachable from other machines.
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# Not yet honored (later phases)
# ---------------------------------------------------------------------------

# LOG_LEVEL / LOG_FORMAT  - observability phase
# DATABASE_URL            - first feature that persists data
# CORS_ENABLED / CORS_ORIGINS - first feature with a browser client
# AUTH_*                  - authentication phase
# RANDOM_SEED, FAKE_*     - fake-data generator and failure-simulation phases
