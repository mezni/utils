# BorneMap Environment Configuration
# Copy this file to .env and adjust values for your local setup

# PostgreSQL - platform_db (system of record)
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=platform_db

# PostgreSQL - analytics_db (event stream)
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5433
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres
ANALYTICS_DB_NAME=analytics_db

# Keycloak
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8083
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
