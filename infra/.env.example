# =============================================================================
# BorneMap — Environment Variable Reference
# =============================================================================
# Copy this file to .env and adjust values before starting.
#   cp infra/.env.example .env
# =============================================================================

# --- Database Connection Strings ---
PLATFORM_DB_URL=postgresql://borneadmin:borne_dev_2026@localhost:5432/platform_db
ANALYTICS_DB_URL=postgresql://borneadmin:borne_dev_2026@localhost:5433/analytics_db

# --- Database Credentials ---
PLATFORM_DB_USER=borneadmin
PLATFORM_DB_PASSWORD=borne_dev_2026
ANALYTICS_DB_USER=borneadmin
ANALYTICS_DB_PASSWORD=borne_dev_2026

# --- Service Ports ---
PLATFORM_DB_PORT=5432
ANALYTICS_DB_PORT=5433

# --- PostGIS ---
POSTGIS_VERSION=3.3

# --- Logging ---
DB_LOG_LEVEL=notice
