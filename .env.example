# BorneMap Environment Configuration
# Copy this file to .env and populate with your values

# ============================================================================
# Database Configuration
# ============================================================================

# Platform database (inventory, users, gis schemas)
DATABASE_URL=postgresql://bornemap_dev:dev_password@localhost:5432/platform_db
DB_USER=bornemap_dev
DB_PASSWORD=dev_password
DB_NAME=platform_db
DB_PORT=5432

# Analytics database (separate from platform_db)
ANALYTICS_DATABASE_URL=postgresql://analytics_dev:analytics_password@localhost:5433/analytics_db
ANALYTICS_DB_USER=analytics_dev
ANALYTICS_DB_PASSWORD=analytics_password
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_PORT=5433

# ============================================================================
# Keycloak Configuration
# ============================================================================

# Keycloak realm and authentication
KEYCLOAK_REALM_URL=http://localhost:8080/realms/bornemap
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=driver-service
KEYCLOAK_CLIENT_SECRET=dev_secret_do_not_use_in_prod

# ============================================================================
# Service Configuration
# ============================================================================

# Driver Service (Station Discovery, Favorites)
DRIVER_SERVICE_PORT=3001

# Partner Service (Partner Dashboard)
PARTNER_SERVICE_PORT=3002

# GIS Worker (Background Job)
GIS_WORKER_INTERVAL_SECS=30

# ============================================================================
# Logging Configuration
# ============================================================================

# Rust logging level (trace, debug, info, warn, error)
RUST_LOG=debug

# Structured logging format (json or text)
LOG_FORMAT=json

# ============================================================================
# PgAdmin Configuration (Optional)
# ============================================================================

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (verbose logging, slower operations)
DEBUG=false

# Enable test mode (use test data, shorter timeouts)
TEST_MODE=false

# Maximum concurrent database connections
DB_POOL_SIZE=10

# ============================================================================
# Rate Limiting (Public Discovery Endpoint)
# ============================================================================

# Rate limit: requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Burst size: allow temporary spikes
RATE_LIMIT_BURST_SIZE=10

# ============================================================================
# GIS Configuration
# ============================================================================

# GIS sync worker polling interval (seconds)
GIS_SYNC_INTERVAL_SECS=30

# GIS sync timeout (seconds)
GIS_SYNC_TIMEOUT_SECS=300

# Outbox max retries before manual intervention
OUTBOX_MAX_RETRIES=5

# ============================================================================
# Performance Tuning
# ============================================================================

# Connection pool size for services
DB_POOL_MAX_CONNECTIONS=20

# Query timeout (milliseconds)
QUERY_TIMEOUT_MS=5000

# Request timeout (milliseconds)
REQUEST_TIMEOUT_MS=30000
