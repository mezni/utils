# BorneMap root configuration
# Copy this to .env and adjust for your environment

# --- General ---
APP_ENV=development
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=json

# --- Service Ports ---
SERVICE_PORT=3001

# --- PostgreSQL ---
DATABASE_URL=postgres://borne:change-me@localhost:5432/bornemap
POSTGRES_USER=borne
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bornemap

# --- RabbitMQ ---
RABBITMQ_URL=amqp://borne:change-me@localhost:5672/
RABBITMQ_DEFAULT_USER=borne
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Keycloak ---
AUTH_SERVER_URL=http://localhost:8080/realms/ev-platform
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Traefik ---
TRAEFIK_API_INSECURE=true
