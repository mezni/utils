# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/auth_db

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ISSUER=borne-map-auth
APP_BASE_URL=http://localhost:8080

# Optional: Password Pepper (development only)
# AUTH_PASSWORD_PEPPER=dev_pepper

# Logging
RUST_LOG=auth_service=debug,tower_http=debug,axum=debug
RUST_BACKTRACE=1