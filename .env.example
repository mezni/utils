# BorneMap Environment Configuration
# Copy this file to .env and override values as needed.
# Sensitive values are managed via GitHub Actions secrets in CI.

# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bornemap
POSTGRES_USER=bornemap
POSTGRES_PASSWORD=bornemap_dev

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=bornemap

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bornemap

# Service ports
AUTH_SERVICE_PORT=3000
CORE_SERVICE_PORT=3001
GEO_SERVICE_PORT=3002
ANALYTICS_SERVICE_PORT=3003

# Logging
LOG_LEVEL=debug
