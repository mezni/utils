# Database Configuration
ANALYTICS_DB_URL=postgresql://admin_service:admin_service_password@localhost:5432/analytics_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cache Configuration
CACHE_TTL_STATION_ANALYTICS=300  # 5 minutes
CACHE_TTL_SUMMARY=600  # 10 minutes
CACHE_TTL_USER_ACTIVITY=300  # 5 minutes
CACHE_TTL_SEARCH_TRENDS=600  # 10 minutes

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3002

# Keycloak Configuration
KEYCLOAK_AUTH_URL=http://localhost:8080/realms/bornemap
KEYCLOAK_CLIENT_ID=bornemap
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Cache Invalidation Configuration
CACHE_INVALIDATION_URL=http://localhost:3002/api/v1/cache/invalidate

# CI/CD Configuration
CI_GATES_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Circuit Breaker Configuration
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_OPEN_DURATION_SECONDS=30

# Materialized View Configuration
MATERIALIZED_VIEW_REFRESH_INTERVAL_SECONDS=300  # 5 minutes

# Performance Configuration
MAX_QUERY_DURATION_MS=500
CACHE_HIT_RATE_TARGET=0.80

# Development Configuration
DEBUG_MODE=false
TEST_MODE=false